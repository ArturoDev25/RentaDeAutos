# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
#
# Required ENV vars:
#   JAVA_HOME - location of a JDK home dir
#
# Optional ENV vars
#   MAVEN_OPTS - parameters passed to the Java VM when running Maven
#     e.g. to debug Maven itself, use
#       export MAVEN_OPTS=-Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=8000
#   MAVEN_SKIP_RC - flag to disable loading of mavenrc files
# ----------------------------------------------------------------------------

if [ -z "$MAVEN_SKIP_RC" ]; then
  if [ -f /usr/local/etc/mavenrc ]; then
    . /usr/local/etc/mavenrc
  fi
  if [ -f /etc/mavenrc ]; then
    . /etc/mavenrc
  fi
  if [ -f "$HOME/.mavenrc" ]; then
    . "$HOME/.mavenrc"
  fi
fi

# OS specific support.  $var _must_ be set to either true or false.
cygwin=false
darwin=false
mingw=false
case "$(uname)" in
  CYGWIN*) cygwin=true ;;
  MINGW*) mingw=true ;;
  Darwin*) darwin=true ;;
esac

## Path to script
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

## Find the project base directory
find_maven_basedir() {
  if [ -z "$1" ]; then
    echo "Path not specified to find_maven_basedir"
    return 1
  fi

  basedir="$1"
  wdir="$1"
  while [ "$wdir" != '/' ]; do
    if [ -d "$wdir"/.mvn ]; then
      basedir=$wdir
      break
    fi
    # workaround for JBEAP-8937 (on a Synology NAS with regular user, can't get directory)
    wdir=$(dirname "$wdir")
  done
  echo "${basedir}"
}

export MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-$(find_maven_basedir "$(pwd)")}
if [ "$MVNW_VERBOSE" = true ]; then
  echo $MAVEN_PROJECTBASEDIR
fi

##########################################################################################
# Extension to allow automatically downloading the maven-wrapper.jar from Maven-central
# This allows using the maven wrapper in projects that prohibit checking in binary data.
##########################################################################################
wrapperJarPath="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
if [ -r "$wrapperJarPath" ]; then
    if [ "$MVNW_VERBOSE" = true ]; then
      echo "Found $wrapperJarPath"
    fi
else
    if [ "$MVNW_VERBOSE" = true ]; then
      echo "Couldn't find $wrapperJarPath, downloading it ..."
    fi

    if [ -n "$MVNW_REPOURL" ]; then
      wrapperUrl="$MVNW_REPOURL/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
    else
      wrapperUrl="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
    fi
    while IFS="=" read key value; do
      case "$key" in (wrapperUrl) wrapperUrl="$value"; break ;;
      esac
    done < "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"
    if [ "$MVNW_VERBOSE" = true ]; then
      echo "Downloading from: $wrapperUrl"
    fi

    wrapperJarParent="$(dirname "$wrapperJarPath")"
    mkdir -p "$wrapperJarParent"
    if [ -n "$MVNW_USERNAME" ] && [ -n "$MVNW_PASSWORD" ]; then
      curl --fail --location --user "$MVNW_USERNAME:$MVNW_PASSWORD" -o "$wrapperJarPath" "$wrapperUrl" ||
        wget --http-user="$MVNW_USERNAME" --http-password="$MVNW_PASSWORD" -O "$wrapperJarPath" "$wrapperUrl"
    else
      curl --fail --location -o "$wrapperJarPath" "$wrapperUrl" ||
        wget -O "$wrapperJarPath" "$wrapperUrl"
    fi
    if [ "$?" != "0" ]; then
      echo "ERROR: Could not download $wrapperUrl"
      exit 1
    fi
fi
##########################################################################################
# End of extension
##########################################################################################

export JAVA_HOME
if [ -z "$JAVA_HOME" ]; then
  javaExecutable="$(which java)"
  if [ -n "$javaExecutable" ] && ! [ "$(expr "$javaExecutable" : '\([^ ]*\)')" = "no" ]; then
    # readlink(1) is not available as standard on Solaris 10.
    readLink=$(which readlink)
    if [ ! "$(expr "$readLink" : '\([^ ]*\)')" = "no" ]; then
      if $darwin; then
        javaHome="$(dirname "$javaExecutable")"
        javaExecutable="$(readlink "$javaExecutable")"
        [ -z "$javaHome" ] || cd "$javaHome"
      fi
      javaExecutable="$(readlink -f "$javaExecutable")"
    fi
    javaHome="$(dirname "$javaExecutable")"
    javaHome=$(expr "$javaHome" : '\(.*\)/bin')
    JAVA_HOME="$javaHome"
    export JAVA_HOME
  fi
fi

if [ -z "$JAVA_HOME" ] && $darwin; then
  JAVA_HOME="$(/usr/libexec/java_home)"
  export JAVA_HOME
fi

if [ -z "$JAVA_HOME" ]; then
  javaExecutable="java"
else
  javaExecutable="$JAVA_HOME/bin/java"
fi

# Detect JVM configs
if [ -f "$MAVEN_PROJECTBASEDIR/.mvn/jvm.config" ]; then
  JVM_CONFIG_MAVEN_PROPS=$(cat "$MAVEN_PROJECTBASEDIR/.mvn/jvm.config")
fi

exec "$javaExecutable" \
  $JVM_CONFIG_MAVEN_PROPS \
  $MAVEN_OPTS \
  $MAVEN_DEBUG_OPTS \
  -classpath "$wrapperJarPath" \
  "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
