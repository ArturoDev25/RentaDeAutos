# =====================================================================
# .env.example — Sistema de Renta de Autos
# Plantilla de variables de entorno para desarrollo local.
#
# Pasos:
#   1. Copia este archivo:  cp .env.example .env
#   2. Ajusta los valores según tu entorno local.
#   3. El archivo .env está en .gitignore — nunca lo commitees.
# =====================================================================

# -----------------------------------------------------------------------
# Base de datos MySQL
# -----------------------------------------------------------------------

# URL de conexión JDBC completa.
# Para desarrollo local con Docker Compose, usa el valor por defecto.
DB_URL=jdbc:mysql://localhost:3306/rentadeautos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Usuario de MySQL (default: root para entorno local/Docker)
DB_USER=root

# Contraseña de MySQL
# Debe coincidir con MYSQL_ROOT_PASSWORD en docker-compose.yml
DB_PASSWORD=root

# Puerto expuesto del contenedor MySQL (debe coincidir con docker-compose.yml)
DB_PORT=3306

# Nombre de la base de datos
DB_NAME=rentadeautos

# Clave para firmar los tokens JWT.
# Genera la tuya con: openssl rand -base64 48
JWT_SECRET="CAMBIAME-genera-tu-propia-clave-con-openssl"
JWT_EXPIRATION_MINUTES=30